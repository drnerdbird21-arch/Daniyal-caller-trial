# ─────────────────────────────────────────────────────────────
# The A Team AI Caller — Environment Variables
# Copy this file to .env and fill in your real values
# NEVER commit .env to GitHub
# ─────────────────────────────────────────────────────────────

# Your Railway app URL (set this after deploying to Railway)
# Example: https://ateam-caller-production.up.railway.app
BASE_URL=https://YOUR-RAILWAY-URL.up.railway.app

# ── Twilio ────────────────────────────────────────────────────
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# ── ElevenLabs ────────────────────────────────────────────────
# Get from: https://elevenlabs.io/profile
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Voice ID — default is "Rachel". 
# To find other voice IDs: https://api.elevenlabs.io/v1/voices
# Recommended voices for Urdu/English mix: Rachel, Aria, Sarah
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Anthropic / Claude ────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Server ────────────────────────────────────────────────────
PORT=3000
